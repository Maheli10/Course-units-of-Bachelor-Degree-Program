#include<stdio.h>
#include<unistd.h>
#include<string.h>

int main(){
	int fdA[2];
	int fdB[2];
	
	pipe(fdA);
	pipe(fdB);
	
	pid_t f1=fork();
	
	if(f1== 0){
		char msg[]= "Hello parent!, from child...";
		close(fdA[0]);
		write(fdA[1],msg, strlen(msg)+1);
		close(fdA[1]);
		
		char pmsg[100];
		close(fdB[1]);
		read(fdB[0], pmsg, sizeof(pmsg));
		printf("Recieved from parent: %s\n", pmsg);
	}
	else{
		char cmsg[100];
		close(fdA[1]);
		read(fdA[0],cmsg, sizeof(cmsg));
		close(fdA[0]);
		printf("recieved from child: %s\n", cmsg);
		
		char msg2[] = "Hello child! from parent...";
		close(fdB[0]);
		write(fdB[1], msg2, strlen(msg2)+1);
		close(fdB[1]);
		
	}
	
	return 0;
}
